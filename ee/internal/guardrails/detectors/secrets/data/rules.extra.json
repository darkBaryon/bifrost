{
 "gitleaks_version": "v8.30.1",
 "_note": "对 Gitleaks 默认规则的修正与新增；依据 product/需求/内容安全/密钥格式核实.md。长度一律前缀加最小长度，终止符沿用 Gitleaks 写法。",
 "remove": ["anthropic-admin-api-key"],
 "replace": [
  {
   "id": "openai-api-key",
   "description": "OpenAI API Key（sk-proj/svcacct/admin/service 或旧版），长度不定，带 T3BlbkFJ 标记",
   "regex": "\\b(sk-(?:(?:proj|svcacct|admin|service)-)?[A-Za-z0-9_-]{20,}T3BlbkFJ[A-Za-z0-9_-]{20,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
   "keywords": ["t3blbkfj"],
   "entropy": 3
  },
  {
   "id": "anthropic-api-key",
   "description": "Anthropic API/Admin Key（sk-ant-api01/api03/admin01 等）",
   "regex": "\\b(sk-ant-[a-z]+\\d{2}-[A-Za-z0-9_-]{80,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
   "keywords": ["sk-ant-"],
   "entropy": 3
  },
  {
   "id": "alibaba-access-key-id",
   "description": "阿里云 AccessKey ID（LTAI 前缀，长度不定）",
   "regex": "\\b(LTAI[A-Za-z0-9]{12,24})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
   "keywords": ["ltai"],
   "entropy": 2
  }
 ],
 "add": [
  {"id": "google-gemini-api-key", "description": "Gemini 新版授权 Key（AQ.Ab8R 前缀）", "regex": "\\b(AQ\\.Ab8R[A-Za-z0-9_-]{46})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["aq.ab8r"], "entropy": 3},
  {"id": "groq-api-key", "description": "Groq API Key", "regex": "\\b(gsk_[A-Za-z0-9]{52})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["gsk_"], "entropy": 3},
  {"id": "cerebras-api-key", "description": "Cerebras API Key", "regex": "\\b(csk-[a-z0-9]{48})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["csk-"], "entropy": 3},
  {"id": "openrouter-api-key", "description": "OpenRouter API Key", "regex": "\\b(sk-or-v1-[0-9a-f]{64})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["sk-or-v1-"], "entropy": 3},
  {"id": "xai-api-key", "description": "xAI API Key 与管理 Key", "regex": "\\b(xai-(?:token-)?[A-Za-z0-9]{80})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["xai-"], "entropy": 3},
  {"id": "replicate-api-token", "description": "Replicate API Token（r8_ 前缀，共 40 位）", "regex": "\\b(r8_[A-Za-z0-9_-]{37})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["r8_"], "entropy": 3},
  {"id": "azure-cognitive-services-key", "description": "Azure OpenAI / Cognitive Services 新版 84 位 Key（JQQJ99 与 ACOG 标记）", "regex": "\\b([0-9A-Za-z]{52}JQQJ99[0-9A-Za-z][A-L][0-9A-Za-z]{12}AAA[0-9A-Za-z]ACOG[0-9A-Za-z]{4})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["jqqj99"], "entropy": 3},
  {"id": "alibaba-bailian-plan-key", "description": "阿里云百炼套餐 API Key（sk-sp- 前缀）", "regex": "\\b(sk-sp-[A-Za-z0-9]{16,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["sk-sp-"], "entropy": 3},
  {"id": "minimax-api-key", "description": "MiniMax 按量 / Token Plan API Key（sk-api- / sk-cp- 前缀）", "regex": "\\b(sk-(?:api|cp)-[A-Za-z0-9_-]{32,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["sk-api-", "sk-cp-"], "entropy": 3},
  {"id": "baidu-qianfan-api-key", "description": "百度千帆新版 API Key（bce-v3/ALTAK-…/… 形态）", "regex": "\\b(bce-v3/ALTAK-[A-Za-z0-9]{16,}/[0-9a-f]{32,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["bce-v3/altak-"], "entropy": 3},
  {"id": "baidu-cloud-access-key", "description": "百度智能云新版 AccessKey（ALTAK 前缀）", "regex": "\\b(ALTAK-?[A-Za-z0-9]{20,})(?:[\\x60'\"\\s;/]|\\\\[nr]|$)", "keywords": ["altak"], "entropy": 3},
  {"id": "zhipu-api-key", "description": "智谱 BigModel API Key（32 位十六进制.16 位）", "regex": "\\b([0-9a-f]{32}\\.[A-Za-z0-9]{16})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": [], "entropy": 3},
  {"id": "alibaba-sts-access-key-id", "description": "阿里云 STS 临时 AccessKey ID（STS. 前缀）", "regex": "\\b(STS\\.[A-Za-z0-9]{12,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["sts."], "entropy": 2},
  {"id": "alibaba-sts-security-token", "description": "阿里云 STS SecurityToken（CAIS 前缀）", "regex": "\\b(CAIS[A-Za-z0-9+/=_-]{60,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["cais"], "entropy": 3},
  {"id": "tencent-cloud-secret-id", "description": "腾讯云 SecretId（AKID 前缀，含临时凭证）", "regex": "\\b(AKID[A-Za-z0-9_-]{32,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["akid"], "entropy": 3},
  {"id": "volcengine-access-key", "description": "火山引擎 AccessKey（AKLT 永久 / AKTP 临时）", "regex": "\\b(AK(?:LT|TP)[A-Za-z0-9+/=_-]{40,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["aklt", "aktp"], "entropy": 3},
  {"id": "dingtalk-robot-webhook", "description": "钉钉自定义机器人 Webhook", "regex": "https://oapi\\.dingtalk\\.com/robot/send\\?access_token=([0-9a-fA-F]{32,})", "keywords": ["oapi.dingtalk.com"], "entropy": 0},
  {"id": "feishu-robot-webhook", "description": "飞书 / Lark 自定义机器人 Webhook", "regex": "https://open\\.(?:feishu\\.cn|larksuite\\.com)/open-apis/bot/v2/hook/([A-Za-z0-9-]{16,})", "keywords": ["/bot/v2/hook/"], "entropy": 0},
  {"id": "wecom-robot-webhook", "description": "企业微信群机器人 Webhook", "regex": "https://qyapi\\.weixin\\.qq\\.com/cgi-bin/webhook/send\\?key=([0-9a-fA-F-]{36})", "keywords": ["cgi-bin/webhook/send"], "entropy": 0},
  {"id": "generic-sk-key", "description": "无法归属厂商的 sk- 类 API Key（DeepSeek、百炼、Kimi、硅基流动、混元、OpenCode 等）", "regex": "\\b(sk-[A-Za-z0-9_-]{32,})(?:[\\x60'\"\\s;]|\\\\[nr]|$)", "keywords": ["sk-"], "entropy": 3, "level": "medium"}
 ],
 "keyword_regex_patch": [
  {
   "id": "generic-api-key",
   "keywords": ["密钥", "秘钥", "密码", "令牌", "口令", "apikey"],
   "regex_replace": [
    ["(?:access|auth|(?-i:[Aa]pi|API)|credential|creds|key|passw(?:or)?d|secret|token)", "(?:access|auth|(?-i:[Aa]pi|API)|apikey|credential|creds|key|passw(?:or)?d|secret|token|密钥|秘钥|密码|令牌|口令)"],
    ["(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)", "(?:=|>|:{1,3}=|\\|\\||:|：|=>|\\?=|,|是|为)"]
   ]
  }
 ]
}
